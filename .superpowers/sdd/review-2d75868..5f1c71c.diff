@@ -0,0 +1,13 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+export function CopyrightYear() {
+  const [year, setYear] = useState<number | null>(null);
+
+  useEffect(() => {
+    setYear(new Date().getFullYear());
+  }, []);
+
+  return <>{year ?? "2026"}</>;
+}
