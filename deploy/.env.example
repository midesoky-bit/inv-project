# Copy to deploy/.env on the server and replace every secret.

POSTGRES_USER=directus
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=directus

DIRECTUS_KEY=replace-with-a-random-key
DIRECTUS_SECRET=replace-with-a-random-secret
DIRECTUS_ADMIN_EMAIL=admin@inventure.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-password
DIRECTUS_PUBLIC_URL=https://cms.example.com

# Image published by .github/workflows/build-image.yml
WEB_IMAGE=ghcr.io/midesoky-bit/inv-project:latest

# Optional. Leave empty when Directus public read is enabled.
CMS_TOKEN=
REVALIDATE_SECRET=replace-with-a-random-secret
