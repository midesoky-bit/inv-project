# Postgres
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
POSTGRES_DB=directus

# Directus (change the secret, key, and admin password before any shared environment)
DIRECTUS_KEY=replace-with-a-random-key
DIRECTUS_SECRET=replace-with-a-random-secret
DIRECTUS_ADMIN_EMAIL=admin@inventure.com
DIRECTUS_ADMIN_PASSWORD=change-me-admin
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_URL=http://localhost:8055

# Next.js
# NEXT_PUBLIC_SITE_URL is read when the image is built, not when the container starts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CMS_PROVIDER=directus
CMS_URL=http://directus:8055
# For `npm run dev` on the host, use http://localhost:8055 so service images load.
CMS_TOKEN=
REVALIDATE_SECRET=
